# Copy to .env and fill from Infisical. Never commit real values.
# DigitalOcean personal access token (starts with dop_v1_) for the digitalocean MCP server
DIGITALOCEAN_API_TOKEN=
# Coolify instance on the DigitalOcean droplet, e.g. https://coolify.example.com
COOLIFY_BASE_URL=
# Coolify API token (format: 123|abc...), created in Coolify under Keys & Tokens
COOLIFY_ACCESS_TOKEN=
